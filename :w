using System.Collections;
using System.Net.Mime;
using Godot;
using HCoroutines;

namespace HolyBread.scripts.dialogues;

public partial class DialogManager : Node
{
    [Export] public Panel MainPanel;
    [Export] public RichTextLabel TextLabel;

    public static DialogManager Instance;

    // Called when the node enters the scene tree for the first time.
    public override void _EnterTree()
    {
        Instance = this;
        MainPanel.Hide();
    }

    public static void ShowText(string text) => Instance._showText(text);
    private void _showText(string text)
    {
        TextLabel.Text = text;
        MainPanel.Show();
        Co.Coroutine(ShowTextCoroutine(text));
    }

    private IEnumerator ShowTextCoroutine(string text)
    {
        var richFlag = false;
        var str = "";
        foreach (var c in text)
        {
            if (c == '[')
                richFlag = true;

            str += c;

            if (!richFlag)
            {
                TextLabel.Text = str;
                yield return null; // TODO: Utilizará un wait
            }
            else if (c == ']') richFlag = false;
        }
    }
}